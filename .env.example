SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# Public Firebase app configuration (copy values from Firebase Console).
FIREBASE_ANDROID_API_KEY=your-android-api-key
FIREBASE_IOS_API_KEY=your-ios-api-key
FIREBASE_MESSAGING_SENDER_ID=your-firebase-sender-id
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_ANDROID_APP_ID=1:1234567890:android:replace-me
FIREBASE_IOS_APP_ID=1:1234567890:ios:replace-me
